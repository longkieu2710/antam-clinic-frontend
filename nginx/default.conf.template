# Cấu hình nginx của container frontend. Lúc container khởi động, image nginx thay chỗ đặt biến
# API_UPSTREAM (viết hoa, trong ngoặc nhọn) bằng biến môi trường cùng tên — mặc định http://api:8080.
# Các biến viết thường như $uri, $http_host là biến của nginx, không bị thay.
server {
    listen       80;
    server_name  _;
    root         /usr/share/nginx/html;
    index        index.html;

    # DNS nội bộ của Docker: tên "api" được tra lúc có request chứ không phải lúc nginx khởi động,
    # nên web vẫn lên khi backend chưa chạy (hoặc khởi động lại, đổi IP)
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $api_upstream ${API_UPSTREAM};

    gzip            on;
    gzip_types      text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # ---- REST API + Swagger → backend (giống proxy của vite dev) ----
    location ~ ^/(api|v3|swagger-ui) {
        proxy_pass         $api_upstream;
        proxy_http_version 1.1;
        # Giữ nguyên Host (kèm cổng) để Swagger "Try it out" gọi lại đúng địa chỉ trình duyệt đang mở
        proxy_set_header   Host              $http_host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        # Báo cáo toàn chuỗi đọc 3 chi nhánh qua postgres_fdw — cho thời gian chờ rộng
        proxy_read_timeout 120s;
        # Backend tắt / chưa lên: trả JSON để giao diện hiện thông báo dễ hiểu thay vì trang lỗi nginx
        error_page 502 503 504 = @api_down;
    }

    location @api_down {
        default_type "application/json; charset=utf-8";
        return 502 '{"status":502,"code":"API_UNAVAILABLE","message":"Không gọi được backend (container api). Kiểm tra: docker compose ps và docker compose logs api"}';
    }

    # ---- File tĩnh có mã hash trong tên → cho trình duyệt cache lâu ----
    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # ---- Route của React (/bac-si, /luot-kham-moi…) → index.html, để F5 không bị 404 ----
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }
}
